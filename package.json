{
  "name": "casedesk-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "casedesk in the browser: one HTML file opened from disk (file://), the Lua core of casedesk.nvim running in wasmoon.",
  "license": "MIT",
  "scripts": {
    "build": "node build/pack.mjs",
    "test": "node --test \"test/*.test.mjs\"",
