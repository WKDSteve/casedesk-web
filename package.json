  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "dependencies": {
    "appkit-web": "github:WKDSteve/appkit#v0.84.1&path:web-kit",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "modern-web-guidance": "1.0.0"
  }
}
